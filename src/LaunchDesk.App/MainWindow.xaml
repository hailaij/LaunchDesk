<Window x:Class="LaunchDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LaunchDesk" Width="1200" Height="800" MinWidth="940" MinHeight="640" WindowStartupLocation="CenterScreen" Closing="WindowClosing" StateChanged="WindowStateChanged">
 <Grid Background="#F5F6F8">
  <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E1E4E9" BorderThickness="0,0,0,1" Padding="22,0">
   <DockPanel VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button Click="ImportClick" ToolTip="导入配置" Style="{StaticResource IconButton}" Content="&#xE8B5;"/>
     <Button Click="ExportConfigClick" ToolTip="导出配置" Style="{StaticResource IconButton}" Content="&#xEDE1;"/>
     <Button Click="RestoreBackupClick" ToolTip="恢复配置备份" Style="{StaticResource IconButton}" Content="&#xE777;"/>
     <Button Click="SettingsClick" ToolTip="设置" Style="{StaticResource IconButton}" Content="&#xE713;"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="LaunchDesk" FontSize="23" FontWeight="SemiBold"/><Border Background="#E7F2ED" Margin="14,0,0,0" Padding="8,3"><TextBlock Text="启动管理" Foreground="#177B59" FontSize="12"/></Border><TextBlock x:Name="SummaryText" Margin="20,0,0,0" Foreground="#667080" VerticalAlignment="Center"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="20,16,20,12">
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="220" MinHeight="130"/><RowDefinition Height="8"/><RowDefinition Height="*" MinHeight="200"/></Grid.RowDefinitions>
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="StartAllClick" Background="#177B59" Foreground="White" BorderBrush="#177B59" Content="全部启动"/><Button Click="StopAllClick" Content="全部停止"/></StackPanel>
    <StackPanel Orientation="Horizontal"><Button Click="AddClick" ToolTip="添加启动项" Style="{StaticResource IconButton}" Content="&#xE710;"/><Button Click="EditClick" ToolTip="编辑" Style="{StaticResource IconButton}" Content="&#xE70F;"/><Button Click="DuplicateClick" ToolTip="复制启动项" Style="{StaticResource IconButton}" Content="&#xE8C8;"/><Button Click="DeleteClick" ToolTip="删除" Style="{StaticResource IconButton}" Content="&#xE74D;"/><Separator Margin="8,0"/><Button Click="MoveUpClick" ToolTip="上移" Style="{StaticResource IconButton}" Content="&#xE70E;"/><Button Click="MoveDownClick" ToolTip="下移" Style="{StaticResource IconButton}" Content="&#xE70D;"/><TextBox x:Name="ItemSearch" Width="170" Margin="12,0,0,5" ToolTip="搜索启动项" TextChanged="ItemSearchChanged"/></StackPanel>
   </DockPanel>
   <DataGrid x:Name="ItemsGrid" Grid.Row="1" SelectionChanged="SelectionChanged" MouseDoubleClick="EditClick">
    <DataGrid.Columns>
     <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180"/>
     <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="90"/>
     <DataGridTemplateColumn Header="状态" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="75"/>
     <DataGridTextColumn Header="运行时长" Binding="{Binding Duration}" Width="90"/>
     <DataGridTextColumn Header="退出码" Binding="{Binding ExitCode}" Width="70"/>
     <DataGridTextColumn Header="资源 / 命令" Binding="{Binding Target}" Width="*" MinWidth="130"/>
     <DataGridTextColumn Header="自启" Binding="{Binding AutoStart}" Width="55"/>
    </DataGrid.Columns>
   </DataGrid>
   <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
   <Grid Grid.Row="3">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="StartButton" Click="StartClick" ToolTip="启动所选项" Style="{StaticResource IconButton}" Content="&#xE768;" Foreground="#177B59"/><Button x:Name="StopButton" Click="StopClick" ToolTip="停止所选项" Style="{StaticResource IconButton}" Content="&#xE71A;"/><Button x:Name="RestartButton" Click="RestartClick" ToolTip="重启所选项" Style="{StaticResource IconButton}" Content="&#xE72C;"/><Separator Margin="8,0"/><Button Click="ExportLogClick" ToolTip="导出全部保留日志" Style="{StaticResource IconButton}" Content="&#xE74E;"/><Button Click="ClearPanelClick" ToolTip="清空面板" Style="{StaticResource IconButton}" Content="&#xE894;"/><Button Click="DeleteHistoryClick" ToolTip="删除历史日志" Style="{StaticResource IconButton}" Content="&#xE74D;"/></StackPanel>
     <TextBlock x:Name="SelectedTitle" Text="日志" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,5"><CheckBox x:Name="PauseLog" DockPanel.Dock="Right" Content="暂停显示" Margin="12,0,4,0"/><ComboBox x:Name="ChannelFilter" Width="110" DockPanel.Dock="Left" SelectionChanged="LogFilterChanged"><ComboBoxItem Content="全部通道"/><ComboBoxItem Content="stdout"/><ComboBoxItem Content="stderr"/><ComboBoxItem Content="system"/><ComboBoxItem Content="stdin"/></ComboBox><TextBox x:Name="LogSearch" Margin="8,0,0,0" ToolTip="搜索日志" TextChanged="LogSearchChanged"/></DockPanel>
    <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" Background="#202329" Foreground="#DFE5EB" BorderThickness="0" FontFamily="Cascadia Mono,Consolas,Microsoft YaHei UI" FontSize="12" Padding="14" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    <DockPanel Grid.Row="3" Margin="0,8,0,0"><Button DockPanel.Dock="Right" Click="SendInputClick" ToolTip="发送输入和回车" Style="{StaticResource IconButton}" Content="&#xE122;"/><TextBox x:Name="InputText" KeyDown="InputKeyDown" ToolTip="标准输入"/></DockPanel>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#ECEFF3" Padding="20,0"><DockPanel VerticalAlignment="Center"><TextBlock x:Name="ModeText" DockPanel.Dock="Right" Foreground="#667080" FontSize="11"/><TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="#596270" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid>
</Window>
