<Window x:Class="LaunchDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LaunchDesk" Title="LaunchDesk" Width="1200" Height="800" MinWidth="940" MinHeight="640" WindowStartupLocation="CenterScreen" Closing="WindowClosing" StateChanged="WindowStateChanged">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <Grid Background="{DynamicResource Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="22,0">
   <DockPanel VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button Click="ImportClick" ToolTip="{DynamicResource '导入配置'}" Style="{StaticResource IconButton}" Content="&#xE8B5;"/>
     <Button Click="ExportConfigClick" ToolTip="{DynamicResource '导出配置'}" Style="{StaticResource IconButton}" Content="&#xEDE1;"/>
     <Button Click="RestoreBackupClick" ToolTip="{DynamicResource '恢复配置备份'}" Style="{StaticResource IconButton}" Content="&#xE777;"/>
     <Button Click="SettingsClick" ToolTip="{DynamicResource '设置'}" Style="{StaticResource IconButton}" Content="&#xE713;"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="{DynamicResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center"/><TextBlock Text="LaunchDesk" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="SummaryText" Margin="24,0,0,0" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="20,16,20,12">
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="2*" MinHeight="130"/><RowDefinition Height="14"/><RowDefinition Height="3*" MinHeight="180"/></Grid.RowDefinitions>
   <DockPanel>
    <Button DockPanel.Dock="Left" Click="AddFolderClick" ToolTip="{DynamicResource '新建文件夹'}" Style="{StaticResource IconButton}" Content="&#xE8F4;" VerticalAlignment="Top"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><Button Click="StartAllClick" Style="{StaticResource PrimaryButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Foreground="White" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource '全部启动'}" Foreground="White"/></StackPanel></Button><Button Click="StopAllClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource '全部停止'}"/></StackPanel></Button></StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Button Click="AddClick" ToolTip="{DynamicResource '添加启动项'}" Style="{StaticResource IconButton}" Content="&#xE710;"/><Button Click="EditClick" ToolTip="{DynamicResource '编辑'}" Style="{StaticResource IconButton}" Content="&#xE70F;"/><Button Click="DuplicateClick" ToolTip="{DynamicResource '复制启动项'}" Style="{StaticResource IconButton}" Content="&#xE8C8;"/><Button Click="DeleteClick" ToolTip="{DynamicResource '删除'}" Style="{StaticResource IconButton}" Content="&#xE74D;"/><Separator Margin="8,0"/><Button Click="MoveUpClick" ToolTip="{DynamicResource '上移'}" Style="{StaticResource IconButton}" Content="&#xE70E;"/><Button Click="MoveDownClick" ToolTip="{DynamicResource '下移'}" Style="{StaticResource IconButton}" Content="&#xE70D;"/><Grid Width="170" Height="36" Margin="12,0,0,0"><TextBox x:Name="ItemSearch" Padding="32,7,10,7" ToolTip="{DynamicResource '搜索启动项'}" TextChanged="ItemSearchChanged"/><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource Muted}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></StackPanel>
   </DockPanel>
   <DataGrid x:Name="ItemsGrid" Grid.Row="1" SelectionChanged="SelectionChanged" AllowDrop="True" PreviewMouseLeftButtonDown="ItemsDragStart" PreviewMouseMove="ItemsDragMove" DragOver="ItemsDragOver" Drop="ItemsDrop">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="{DynamicResource '名称'}" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel Margin="{Binding NameIndent}"><Button DockPanel.Dock="Left" Click="ToggleFolderClick" Visibility="{Binding IsFolder, Converter={StaticResource BoolVisibility}}" Style="{StaticResource IconButton}" Content="{Binding CollapseGlyph}" Width="18" Height="28" MinHeight="28" Margin="0,0,4,0" FontSize="10" ToolTip="{DynamicResource '展开 / 收起文件夹'}"/><TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0" VerticalAlignment="Center"/><Grid><TextBlock Text="{Binding Name}" Visibility="{Binding NameVisibility}" MouseLeftButtonDown="NameClick" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding EditorVisibility}" IsVisibleChanged="NameEditorVisible" KeyDown="NameEditorKeyDown" LostKeyboardFocus="NameEditorLostFocus" MaxLength="100" Padding="4" MinHeight="28" VerticalAlignment="Center"/></Grid></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="{DynamicResource '类型'}" Binding="{Binding Kind}" Width="100"/>
     <DataGridTemplateColumn Header="{DynamicResource '状态'}" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" ToolTip="{Binding Detail}"><Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn x:Name="PidColumn" Header="PID" Binding="{Binding Pid}" Width="65"/>
     <DataGridTextColumn Header="{DynamicResource '运行时长'}" Binding="{Binding Duration}" Width="80"/>
     <DataGridTextColumn Header="{DynamicResource '顺序'}" Binding="{Binding StartupOrder}" Width="62"/>
     <DataGridTextColumn x:Name="ExitCodeColumn" Header="{DynamicResource '退出码'}" Binding="{Binding ExitCode}" Width="65"/>
     <DataGridTemplateColumn Header="{DynamicResource '资源 / 命令'}" Width="*" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Target}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="{DynamicResource '自启'}" Binding="{Binding AutoStart}" Width="70" MinWidth="70" CanUserResize="False"><DataGridTextColumn.HeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,0"/></Style></DataGridTextColumn.HeaderStyle></DataGridTextColumn>
     <DataGridTemplateColumn Header="{DynamicResource '操作'}" Width="144" CanUserResize="False"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Click="RowActionClick" Tag="Run" IsEnabled="{Binding CanRun}" ToolTip="{DynamicResource '运行'}" Style="{StaticResource IconButton}" Content="&#xE768;" Width="26" Height="30" MinHeight="30"/><Button Click="RowActionClick" Tag="Stop" IsEnabled="{Binding CanStop}" ToolTip="{DynamicResource '停止'}" Style="{StaticResource IconButton}" Content="&#xE71A;" Width="26" Height="30" MinHeight="30"/><Button Click="RowActionClick" Tag="Edit" IsEnabled="{Binding CanModify}" ToolTip="{DynamicResource '编辑'}" Style="{StaticResource IconButton}" Content="&#xE70F;" Width="26" Height="30" MinHeight="30"/><Button Click="RowActionClick" Tag="Delete" IsEnabled="{Binding CanModify}" ToolTip="{DynamicResource '删除'}" Style="{StaticResource IconButton}" Content="&#xE74D;" Width="26" Height="30" MinHeight="30"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock x:Name="EmptyItems" Grid.Row="1" Text="{DynamicResource '暂无启动项'}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
   <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
   <Grid Grid.Row="3">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="StartButton" Click="StartClick" ToolTip="{DynamicResource '启动所选项'}" Style="{StaticResource IconButton}" Content="&#xE768;" Foreground="#177B59"/><Button x:Name="StopButton" Click="StopClick" ToolTip="{DynamicResource '停止所选项'}" Style="{StaticResource IconButton}" Content="&#xE71A;"/><Button x:Name="RestartButton" Click="RestartClick" ToolTip="{DynamicResource '重启所选项'}" Style="{StaticResource IconButton}" Content="&#xE72C;"/><Separator Margin="8,0"/><Button Click="ExportLogClick" ToolTip="{DynamicResource '导出全部保留日志'}" Style="{StaticResource IconButton}" Content="&#xE74E;"/><Button Click="ClearPanelClick" ToolTip="{DynamicResource '清空面板'}" Style="{StaticResource IconButton}" Content="&#xE894;"/><Button Click="DeleteHistoryClick" ToolTip="{DynamicResource '删除历史日志'}" Style="{StaticResource IconButton}" Content="&#xE74D;"/></StackPanel>
     <TextBlock x:Name="SelectedTitle" Text="{DynamicResource '日志'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,8"><CheckBox x:Name="PauseLog" DockPanel.Dock="Right" Content="{DynamicResource '暂停显示'}" Margin="12,0,4,0" Checked="LogFilterChanged" Unchecked="LogFilterChanged"/><CheckBox x:Name="AutoScroll" DockPanel.Dock="Right" Content="{DynamicResource '自动滚动'}" IsChecked="True" Margin="12,0,4,0"/><ComboBox x:Name="ChannelFilter" Width="110" DockPanel.Dock="Left" SelectionChanged="LogFilterChanged"><ComboBoxItem Content="{DynamicResource '全部通道'}"/><ComboBoxItem Content="stdout"/><ComboBoxItem Content="stderr"/><ComboBoxItem Content="system"/><ComboBoxItem Content="stdin"/></ComboBox><TextBox x:Name="LogSearch" Margin="8,0,0,0" ToolTip="{DynamicResource '搜索日志'}" TextChanged="LogSearchChanged"/></DockPanel>
    <local:LogView x:Name="LogBox" Grid.Row="2" Background="{DynamicResource Terminal}" Foreground="{DynamicResource TerminalText}" BorderThickness="0" FontFamily="Cascadia Mono,Consolas,Microsoft YaHei UI" FontSize="12" Padding="16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    <DockPanel Grid.Row="3" Margin="0,8,0,0"><Button DockPanel.Dock="Right" Click="SendInputClick" ToolTip="{DynamicResource '发送输入和回车'}" Style="{StaticResource IconButton}" Content="&#xE122;"/><TextBox x:Name="InputText" KeyDown="InputKeyDown" ToolTip="{DynamicResource '标准输入'}"/></DockPanel>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="20,0"><DockPanel VerticalAlignment="Center"><TextBlock x:Name="ModeText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="StatusText" Text="{DynamicResource '就绪'}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
 </Grid>
</Window>
